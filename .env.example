# Copy to .env and fill in values. Never commit .env.

# Flask sessions and CSRF. Required when debug is disabled.
# Local `python app.py` can keep the default; set a random value for any shared or production run.
SECRET_KEY=

# Relational database. Leave unset to use local SQLite at instance/campus_plus.db.
# somee.com MSSQL (shared by Flask and the worker):
# DATABASE_URL=mssql+pymssql://USER:PASSWORD@SERVER.somee.com/DATABASE
DATABASE_URL=

# Local ChromaDB directory on the demo / dev machine (not cloud).
# One person fills this with scripts/seed_embeddings.py; others copy the folder.
CHROMA_PERSIST_DIR=instance/chroma

# Google AI Studio key — embeddings and summaries (worker + seed embeddings).
GEMINI_API_KEY=

# Tavily MCP tool — academic verification in the worker.
TAVILY_API_KEY=

# Gmail MCP tool (mcp_tools/gmail_alert). Format: you@gmail.com:app-password
# Empty = log-only stub. Used after a student upload to email administrators.
GMAIL_MCP_CREDENTIALS=

# Optional. Unset or true keeps the local debug server. Set false/0 to disable debug.
# FLASK_DEBUG=true
