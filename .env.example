# ──────────────────────────────────────────────────
# Campus+ environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is git-ignored.
# ──────────────────────────────────────────────────

SECRET_KEY=<random-secret-for-flask-sessions>

# ── Database (somee.com MSSQL) ────────────────────
# Option A: single SQLAlchemy URI (preferred)
DATABASE_URL=mssql+pymssql://<user>:<password>@<server>.mssql.somee.com/<dbname>

# Option B: individual credentials (used only when DATABASE_URL is not set).
# Set all four, or none. A partial set stops startup.
# The app URL-encodes DB_USER and DB_PASSWORD.
# DB_SERVER=<server>.mssql.somee.com
# DB_NAME=<dbname>
# DB_USER=<user>
# DB_PASSWORD=<password>

# Omit DATABASE_URL and all four DB_* variables to use local SQLite
# (instance/campus_plus.db).

# ── AI / Vector DB ────────────────────────────────
GEMINI_API_KEY=<google-ai-studio-key>
# Optional. Defaults: gemini-embedding-001 and gemini-3.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_SUMMARY_MODEL=gemini-3.5-flash
TAVILY_API_KEY=<tavily-key>
CHROMA_PERSIST_DIR=instance/chroma

# ── MCP Tools ─────────────────────────────────────
# Gmail sender for admin alerts after a student upload.
# Format: you@gmail.com:your-app-password
# Empty = log-only stub (no real email).
GMAIL_MCP_CREDENTIALS=<gmail-oauth-or-app-password>

# Optional. Unset or true keeps the local debug server. Set false/0 to disable debug.
# FLASK_DEBUG=true
